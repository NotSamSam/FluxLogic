# Logging
FLUXLOGIC_LOG_LEVEL=INFO
FLUXLOGIC_DEBUG=false

# API defaults
FLUXLOGIC_DEFAULT_TIMEOUT=30
FLUXLOGIC_MAX_RETRIES=3
FLUXLOGIC_RETRY_BACKOFF_FACTOR=0.5

# Processing
FLUXLOGIC_BATCH_SIZE=100
FLUXLOGIC_MAX_UPLOAD_SIZE_MB=50

# Webhook
FLUXLOGIC_WEBHOOK_PORT=8501
# FLUXLOGIC_WEBHOOK_SECRET=your-hmac-secret-here
